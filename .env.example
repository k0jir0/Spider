SPIDER_PROVIDER=local
SPIDER_WORKSPACE=workspace
SPIDER_DATA_DIR=.spider
SPIDER_MAX_STEPS=16
SPIDER_TIMEOUT_MS=120000
SPIDER_MAX_TOKENS=1024

# Leave these unset to use provider-specific defaults.
# SPIDER_MODEL=spider-local
# SPIDER_BASE_URL=http://127.0.0.1:8089/v1

# Required only for the OpenAI provider. Never commit a real key.
# OPENAI_API_KEY=
# SPIDER_API_KEY=